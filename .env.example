# AppFlowy Coolify Deployment Configuration
# Copy this file to .env and update the values

# Domain Configuration
APPFLOWY_DOMAIN=appflowy.yourdomain.com

# NGINX Configuration
NGINX_PORT=80
NGINX_TLS_PORT=443

# PostgreSQL Database Configuration
POSTGRES_USER=appflowy
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=appflowy
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=change-this-redis-password

# MinIO (S3-compatible storage) Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# GoTrue (Authentication) Configuration
GOTRUE_SITE_URL=https://appflowy.yourdomain.com
GOTRUE_URI_ALLOW_LIST=*
GOTRUE_JWT_SECRET=change-this-super-secret-jwt-token-with-at-least-32-characters-long
GOTRUE_JWT_EXP=3600
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_DISABLE_SIGNUP=false

# SMTP Configuration (for email notifications)
GOTRUE_SMTP_HOST=smtp.gmail.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=your-email@gmail.com
GOTRUE_SMTP_PASS=your-app-password
GOTRUE_SMTP_ADMIN_EMAIL=admin@yourdomain.com
GOTRUE_EXTERNAL_EMAIL_ENABLED=true

# AppFlowy Cloud Configuration
RUST_LOG=info
APPFLOWY_ENVIRONMENT=production
APPFLOWY_S3_BUCKET=appflowy
APPFLOWY_S3_REGION=us-east-1
APPFLOWY_S3_USE_MINIO=true

# AppFlowy Mailer Configuration (optional, can reuse SMTP settings)
APPFLOWY_MAILER_SMTP_HOST=smtp.gmail.com
APPFLOWY_MAILER_SMTP_PORT=587
APPFLOWY_MAILER_SMTP_USERNAME=your-email@gmail.com
APPFLOWY_MAILER_SMTP_PASSWORD=your-app-password
